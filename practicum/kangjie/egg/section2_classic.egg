;; §2 running example, written as an .egg file.
;; Today the engine has no (domain …), no :abstract, no within guard.
;; Expected today: sort/resolve error on `within`, or the rewrite never fires
;; because there is no abstract column. That is the baseline the proposal
;; asks us to record.
;;
;; EXPECT: error
;; TYPES: bignum
(sort B)
(sort I)
(function True () B)
(function Lt (I I) B)
(function Lit (IBig) I)
(function Add (I I) I)
(function Ite (B I I) I)
(function Clamp (I I I) I)
(let three (Lit 3))
(let ten (Lit 10))
(let c (Lt three ten))
(let t (Ite c three ten))
(union c (True))
(let u (Clamp t (Lit 0) (Lit 255)))
(rewrite (Clamp x (Lit 0) (Lit 255)) x :when ((within x 0 255)))
(run 3)
